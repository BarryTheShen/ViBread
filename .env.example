# Copy to .env (same folder) and fill in what you need. Every value is optional.

# Where the server listens and the address other devices/links should use (QR codes, OAuth, `claude mcp add`).
# PORT=8787
# HOST=0.0.0.0
# PUBLIC_URL=http://localhost:8787
# VIBREAD_PHONE_URL=http://192.168.1.24:8787
# VIBREAD_LAN_PAIRING=off
# SQLite database, artifacts, generated secrets (relative paths are relative to the repo root).
# DATA_DIR=./data

# ViBread's server key for the AI agents. Alternatively, each user can connect their own Claude account (sign-in) or
# save their own API key in Settings → Claude; those are stored per user in the database.
# ANTHROPIC_API_KEY=
# VIBREAD_MODEL=claude-opus-5-5
# VIBREAD_FAST_MODEL=claude-sonnet-5
# Anthropic API origin (e.g. a proxy); a trailing /v1 is accepted.
# ANTHROPIC_BASE_URL=
# "plain" turns off pi-ai's newer Claude request features from the start (the server also falls back by itself).
# VIBREAD_CLAUDE_PROTOCOL=managed

# Sign-in (without these the server runs in single-operator mode: no sign-in, one user).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# iMessage (Photon Spectrum): off | terminal | cloud
# CAPCOM_PROVIDER=off
# PHOTON_PROJECT_ID=
# PHOTON_PROJECT_SECRET=
# CAPCOM_NUMBER=


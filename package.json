{
  "name": "vibread",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "fixtures"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "setup:toolchain": "node scripts/setup-toolchain.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck -w @vibread/web",
    "dev:server": "npm run dev -w @vibread/server",
    "dev:web": "npm run dev -w @vibread/web",
    "build": "npm run build -w @vibread/web",
    "start": "npm start -w @vibread/server",
    "postinstall": "cd packages/assembly/schematic-runtime && npm install --no-audit --no-fund --install-links=false",
    "seed": "tsx --env-file-if-exists=.env scripts/seed-golden.ts",
    "fault-table": "tsx packages/bench/scripts/fault-table.ts",
    "desktop": "npm run build && npm start -w @vibread/desktop",
    "desktop:dist": "npm run build && npm run dist -w @vibread/desktop"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@vibread/fixtures": "0.1.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}

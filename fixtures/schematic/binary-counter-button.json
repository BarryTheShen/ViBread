  "sketch": {
    "source": "// 5-Light Binary Counter \u2014 each button press adds one, shown in binary on five lights.\n\nconst uint8_t BUTTON_PIN = 2;                 // button to GND, INPUT_PULLUP\nconst uint8_t LED_PINS[5] = {3, 4, 5, 6, 7};  // bit 0 (1s, rightmost) .. bit 4 (16s, leftmost)\nconst unsigned long DEBOUNCE_MS = 30;\n\nuint8_t count = 0;\nbool stableState = HIGH;\nbool lastReading = HIGH;\nunsigned long lastChange = 0;\n\nvoid showCount() {\n  for (uint8_t i = 0; i < 5; i++) {\n    digitalWrite(LED_PINS[i], ((count >> i) & 1) ? HIGH : LOW);\n  }\n}\n\nvoid setup() {\n  pinMode(BUTTON_PIN, INPUT_PULLUP);\n  for (uint8_t i = 0; i < 5; i++) {\n    pinMode(LED_PINS[i], OUTPUT);\n    digitalWrite(LED_PINS[i], LOW);\n  }\n  Serial.begin(115200);\n  Serial.println(F(\"binary-counter ready, count 0\"));\n  showCount();\n}\n\nvoid loop() {\n  bool reading = digitalRead(BUTTON_PIN);\n  unsigned long now = millis();\n  if (reading != lastReading) {\n    lastReading = reading;\n    lastChange = now;\n  }\n  if (reading != stableState && (now - lastChange) >= DEBOUNCE_MS) {\n    stableState = reading;\n    if (stableState == LOW) {          // press edge\n      count = (count + 1) & 0x1F;      // 0..31, then back to 0\n      showCount();\n      Serial.print(F(\"count \"));\n      Serial.println(count);\n    }\n  }\n}\n"
  },

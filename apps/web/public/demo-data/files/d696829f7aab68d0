\nconst uint8_t BUTTON_PIN = 7;               // button to GND, internal pull-up\nconst uint8_t LIGHT_PIN = A0;               // photoresistor to 5V, 10k to GND\nconst unsigned long DEBOUNCE_MS = 30;\n\n// bit 3 = leftmost light, bit 0 = rightmost light\nconst uint8_t PHASE_MASK[8] = {0b0000, 0b0001, 0b0011, 0b0111, 0b1111, 0b1110, 0b1100, 0b1000};\nconst char* const PHASE_NAME[8] = {\n  \"new moon\", \"waxing crescent\", \"first quarter\", \"waxing gibbous\",\n  \"full moon\", \"waning gibbous\", \"last quarter\", \"waning crescent\"\n};\n\nuint8_t phase = 4;          // start at full moon\nbool dark = false;\nbool buttonStable = HIGH;\nbool buttonLastRaw = HIGH;\nunsigned long buttonChangedAt = 0;\n\nvoid showLights() {\n  uint8_t mask = dark ? PHASE_MASK[phase] : 0;\n  for (uint8_t i = 0; i < 4; i++) {\n    digitalWrite(LED_PINS[i], (mask & (0b1000 >> i)) ? HIGH : LOW);\n  }\n}\n\nvoid setup() {\n  for (uint8_t i = 0; i < 4; i++) {\n    pinMode(LED_PINS[i], OUTPUT);\n    digitalWrite(LED_PINS[i], LOW);\n  }\n  pinMode(BUTTON_PIN, INPUT_PULLUP);\n  Serial.begin(115200);\n  dark = analogRead(LIGHT_PIN) < VB_CAL_LDR1_DARK;\n  Serial.print(F(\"moon-lamp ready, phase=\"));\n  Serial.print(PHASE_NAME[phase]);\n  Serial.println(dark ? F(\", dark\") : F(\", bright\"));\n  showLights();\n}\n\nvoid loop() {\n  unsigned long now = millis();\n\n  // Debounced button: act once on the press edge.\n  bool raw = digitalRead(BUTTON_PIN);\n  if (raw != buttonLastRaw) {\n    buttonLastRaw = raw;\n    buttonChangedAt = now;\n  }\n  if (raw != buttonStable && now - buttonChangedAt >= DEBOUNCE_MS) {\n    buttonStable = raw;\n    if (buttonStable == LOW) {\n      phase = (phase + 1) % 8;\n      Serial.print(F(\"phase=\"));\n      Serial.println(PHASE_NAME[phase]);\n      showLights();\n    }\n  }\n\n  // Room light with hysteresis.\n  int level = analogRead(LIGHT_PIN);\n  if (!dark && level < VB_CAL_LDR1_DARK) {\n    dark = true;\n    Serial.println(F(\"room dark: lamp on\"));\n    showLights();\n  } else if (dark && level > VB_CAL_LDR1_DARK + VB_CAL_LDR1_HYST) {\n    dark = false;\n    Serial.println(F(\"room bright: lamp off\"));\n    showLights();\n  }\n}\n"},"intent":[{"id":"C1","text":"The four lights in a row (D2 leftmost, D3, D4, D5 rightmost) show the moon phase. The cycle has 8 phases in order: new moon (no lights), waxing crescent (rightmost only), first quarter (right two), waxing gibbous (right three), full moon (all four), waning gibbous (left three), last quarter (left two), waning crescent (leftmost only), then back to new moon."},{"id":"C2","text":"The lamp starts at full moon."},{"id":"C3","text":"Each press of the button moves exactly one phase forward in the cycle, once per press (holding the button does not keep stepping; bounces shorter than 30 ms do not count as extra presses)."},{"id":"C4","text":"The lights only glow when the room is dark (A0 reading below 300). When the room is bright (A0 reading above 340), all four lights are off, and they come back showing the current phase when it gets dark again."},{"id":"C5","text":"The button still steps the phase while the room is bright; the new phase shows once the room is dark."},{"id":"C6","text":"Between readings of 300 and 340 the lamp keeps its previous on/off state, so it doesn't flicker at the boundary."}],"assumptions":["'Next day's phase' is simplified to the next of the 8 classic moon phases per press, since four lights can only show 8 distinct shapes.","The moon is shown as seen from the northern hemisphere: it grows from the right and shrinks from the right.","Light sensor: photoresistor from 5V to A0, 10 kΩ from A0 to GND, so a darker room gives a lower A0 reading.","Dark below a reading of 300, bright again above 340 (the bench calibrates both). At power-up the lamp counts as dark only if the reading is below 300.","The phase is not remembered after power-off; it starts at full moon each time.","Four yellow LEDs with 220 Ω resistors draw about 14 mA each, about 56 
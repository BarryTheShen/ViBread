{
  "name": "@vibread/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "ViBread desktop app: AI-assisted Arduino prototyping with a built-in USB bench.",
  "author": {
    "name": "ViBread",
    "email": "vibread@users.noreply.github.com"
  },
  "homepage": "https://github.com/BarryTheShen/ViBread",
  "license": "MIT",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "stage": "node scripts/stage-runtime.mjs",
    "start": "npm run build && electron .",
    "dist": "npm run build && npm run stage && electron-builder --config electron-builder.config.cjs --publish never",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/qrcode": "1.5.6",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "qrcode": "1.5.4"
  }
}
